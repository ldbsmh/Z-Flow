# Z-Flow 签名配置（本文件不入库，包含密码）
# 请填写真实的 storePassword / keyPassword 后本地编译即可自动签名。
# CI 构建时密码从 GitHub Secrets 注入（SIGNING_STORE_PASSWORD / SIGNING_KEY_PASSWORD），
# 不需要本文件。

# keystore 文件路径（相对项目根目录，或绝对路径）
storeFile=keystore/Key_20260204_154509.jks

# keystore 密码（必须填写）
storePassword=

# keyAlias（从 keystore 读取确认）
keyAlias=key_20260204_154509

# 密钥密码（必须填写）
keyPassword=
